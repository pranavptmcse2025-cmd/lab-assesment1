import random

# Global counters for comparisons
naive_comparisons = 0
dac_comparisons = 0

def find_min_max_naive(arr):
    """
    Naive approach to find minimum and maximum.
    Iterates through the array and updates min and max.
    """
    global naive_comparisons
    naive_comparisons = 0
    
    n = len(arr)
    if n == 0:
        return None, None
    
    current_min = arr[0]
    current_max = arr[0]
    
    for i in range(1, n):
        # 1st comparison for min
        naive_comparisons += 1
        if arr[i] < current_min:
            current_min = arr[i]
            
        # 2nd comparison for max
        naive_comparisons += 1
        if arr[i] > current_max:
            current_max = arr[i]
            
    return current_min, current_max


def find_min_max_dac(arr, low, high):
    """
    Divide and Conquer approach to find minimum and maximum.
    Divides the array into two halves, recursively finds min and max for each,
    and then combines the results.
    """
    global dac_comparisons
    
    # Case 1: Only one element
    if low == high:
        return arr[low], arr[low]
    
    # Case 2: Only two elements
    if high == low + 1:
        dac_comparisons += 1
        if arr[low] < arr[high]:
            return arr[low], arr[high]
        else:
            return arr[high], arr[low]
            
    # Case 3: More than two elements - Divide & Conquer
    mid = (low + high) // 2
    
    min_left, max_left = find_min_max_dac(arr, low, mid)
    min_right, max_right = find_min_max_dac(arr, mid + 1, high)
    
    # Combine: Compare min of both halves and max of both halves
    dac_comparisons += 1
    final_min = min_left if min_left < min_right else min_right
    
    dac_comparisons += 1
    final_max = max_left if max_left > max_right else max_right
    
    return final_min, final_max


# --- Testing and Comparison ---
sizes = [10, 100, 1000, 10000]

print(f"{'Array Size (n)':<15} | {'Naive Comparisons':<20} | {'D&C Comparisons':<20} | {'Theoretical D&C (3n/2 - 2)':<25}")
print("-" * 88)

for size in sizes:
    # Generate random test array
    data = [random.randint(1, 100000) for _ in range(size)]
    
    # Naive Run
    find_min_max_naive(data)
    
    # D&C Run
    dac_comparisons = 0
    find_min_max_dac(data, 0, len(data) - 1)
    
    # Theoretical estimate for powers of 2 size
    theoretical = int(1.5 * size - 2) if size > 1 else 0
    
    print(f"{size:<15} | {naive_comparisons:<20} | {dac_comparisons:<20} | {theoretical:<25}")
