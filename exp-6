# Matrix Chain Multiplication using Dynamic Programming

def matrix_chain_order(p):
    n = len(p) - 1

    # m[i][j] stores minimum multiplication cost
    m = [[0 for _ in range(n + 1)] for _ in range(n + 1)]

    # s[i][j] stores the position of split
    s = [[0 for _ in range(n + 1)] for _ in range(n + 1)]

    # Chain length
    for length in range(2, n + 1):

        for i in range(1, n - length + 2):
            j = i + length - 1
            m[i][j] = float('inf')

            # Try every possible split
            for k in range(i, j):
                cost = (
                    m[i][k]
                    + m[k + 1][j]
                    + p[i - 1] * p[k] * p[j]
                )

                if cost < m[i][j]:
                    m[i][j] = cost
                    s[i][j] = k

    return m, s


# Print optimal parenthesization
def print_optimal_order(s, i, j):
    if i == j:
        return f"A{i}"

    k = s[i][j]

    left = print_optimal_order(s, i, k)
    right = print_optimal_order(s, k + 1, j)

    return f"({left} x {right})"


# Matrix dimensions:
# A1 = 10 x 30
# A2 = 30 x 5
# A3 = 5 x 60
# A4 = 60 x 10

p = [10, 30, 5, 60, 10]

m, s = matrix_chain_order(p)

n = len(p) - 1

print("Optimal Order:", print_optimal_order(s, 1, n))
print("Minimum Scalar Multiplications:", m[1][n])
